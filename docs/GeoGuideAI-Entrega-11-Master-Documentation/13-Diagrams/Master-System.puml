actor Traveler
rectangle "Flutter Mobile" as Mobile
rectangle "Nginx / HTTPS" as Edge
rectangle "Spring Boot Modular Monolith" as API
database "PostgreSQL + PostGIS" as DB
rectangle Redis
rectangle MinIO
rectangle "Routing Engine" as Routing
rectangle "Optional AI Layer" as AI

Traveler --> Mobile
Mobile --> Edge
