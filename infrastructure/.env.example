# Copy this file to .env and replace every CHANGE_ME value.
# The real .env file is ignored by Git.
POSTGRES_DB=geoguide
POSTGRES_USER=geoguide_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_LOCAL_PASSWORD
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=geoguide_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_AT_LEAST_8_CHARACTERS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# GraphHopper routing. Keep the PBF and generated graph outside Git.
GRAPHHOPPER_VERSION=11.0
GRAPHHOPPER_SHA256=b59c024afe172ec6ec85b6327006c3138ec58c7d0bcd26253d0e42853f613def
GRAPHHOPPER_XMS=512m
GRAPHHOPPER_XMX=4g
GRAPHHOPPER_MEMORY_LIMIT=5g
ROUTING_PBF_PATH=./routing/data/peru-geoguide-pilot.osm.pbf
ROUTING_GRAPH_DIR=./routing/data/graph-cache
