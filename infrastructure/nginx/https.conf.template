limit_req_zone $binary_remote_addr zone=admin_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=admin_auth:10m rate=5r/s;

server {
    listen 80;
    server_name ${GEOGUIDE_API_DOMAIN};

    location / {
        return 308 https://$host:${GEOGUIDE_PUBLIC_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${GEOGUIDE_API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${GEOGUIDE_API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${GEOGUIDE_API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    server_tokens off;

    location = /admin {
        return 308 /admin/;
    }

    location ^~ /admin/ {
        proxy_pass http://admin-portal/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port ${GEOGUIDE_PUBLIC_HTTPS_PORT};
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
    }

    location ^~ /auth/ {
        limit_req zone=admin_auth burst=10 nodelay;
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port ${GEOGUIDE_PUBLIC_HTTPS_PORT};
        proxy_read_timeout 60s;
        client_max_body_size 64k;
    }

    location ^~ /api/v1/admin/pois/ {
        limit_req zone=admin_api burst=20 nodelay;
        client_max_body_size 10m;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location ^~ /api/v1/admin/ {
        limit_req zone=admin_api burst=20 nodelay;
        client_max_body_size 64k;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
    }
}
